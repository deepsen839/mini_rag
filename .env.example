# Required: Qdrant Cloud cluster URL and API key
QDRANT_URL=@@@@@@@@@@@@@@@@@@@@@
QDRANT_API_KEY=####################333
QDRANT_COLLECTION=minirag_documents

# Embeddings: OpenAI text-embedding-3-small (1536 dimensions)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# LLM: official Groq Python SDK (endpoint is managed by the SDK)
# LLM: official Groq Python SDK (endpoint is managed by the SDK)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=#####################33

# Optional Cohere reranker. Without this, a documented lexical fallback is used.
COHERE_API_KEY=##############################
COHERE_RERANK_MODEL=rerank-v3.5

CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

RETRIEVAL_TOP_K=10
RERANK_TOP_N=3

MAX_UPLOAD_MB=15
APP_ENV=development

# LangSmith observability (optional)
# Create an API key at https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=#######################
LANGSMITH_PROJECT=mini-rag-assessment
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Reject weak retrieval matches instead of sending unrelated chunks to the LLM
MIN_RELEVANCE_SCORE=0.18

# Qdrant HNSW index settings (conservative starting values for small clusters)
HNSW_ENABLED=true
HNSW_M=16
HNSW_EF_CONSTRUCT=100
HNSW_EF=128
